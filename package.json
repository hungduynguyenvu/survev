{
  "build": {
    "appId": "io.survev.desktopclient",
    "productName": "Survev Desktop",
    "executableName": "Survev",

    "directories": {
      "output": "desktop-release"
    },

    "asar": true,

    "files": [
      "desktop/main.cjs"
    ],

    "extraFiles": [
      {
        "from": "client/dist",
        "to": "client",
        "filter": [
          "**/*"
        ]
      }
    ]
  },

  "name": "survev",
  "version": "0.4.1",
  "main": "desktop/main.cjs",
  "type": "module",
  "description": "Open Source Surviv.io Server",
  "scripts": {
    "survev-setup": "pnpm install && tsx setup.ts",
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:game\" \"pnpm run dev:client\"",
    "dev:server": "cd server && pnpm dev",
    "dev:api": "cd server && pnpm dev:api",
    "dev:game": "cd server && pnpm dev:game",
    "dev:client": "cd client && pnpm dev",
    "build": "cd server && pnpm build && cd ../client && pnpm build",
    "stressTest": "cd server && pnpm stressTest",
    "lint": "oxlint --fix; dprint fmt",
    "lint:ci": "oxlint; dprint check",
    "desktop": "electron desktop/main.cjs",
    "desktop:pack": "pnpm --dir client build && electron-builder --win --x64 --dir",
    "desktop:zip": "pnpm --dir client build && electron-builder --win zip --x64"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "Leia",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/hjson": "^2.4.6",
    "@types/node": "~22.12.0",
    "concurrently": "^10.0.5",
    "dprint": "^0.55.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "hjson": "^3.2.2",
    "tsx": "^4.23.13"
  },
  "packageManager": "pnpm@11.24.0"
}
